{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beyond90.example/schemas/match-v1.json",
  "title": "Beyond90 Synthetic Match",
  "type": "object",
  "required": [
    "matchId",
    "homeTeamId",
    "awayTeamId",
    "dataStatus",
    "rosterSeason",
    "rosterSource",
    "rosterSourceUrl",
    "teams",
    "players",
    "events",
    "decisionSnapshots"
  ],
  "properties": {
    "matchId": {
      "type": "string",
      "minLength": 1
    },
    "homeTeamId": {
      "type": "string",
      "minLength": 1
    },
    "awayTeamId": {
      "type": "string",
      "minLength": 1
    },
    "teams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "teamId",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "teamId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": [
              "string",
              "null"
            ]
          },
          "dominantFoot": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "Left",
              "Right",
              "Both",
              null
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "matchId",
          "eventId",
          "sequence",
          "minute",
          "second",
          "teamId",
          "playerId",
          "type",
          "x",
          "y"
        ],
        "properties": {
          "matchId": {
            "type": "string",
            "minLength": 1
          },
          "eventId": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "minute": {
            "type": "integer",
            "minimum": 0
          },
          "second": {
            "type": "integer",
            "minimum": 0,
            "maximum": 59
          },
          "teamId": {
            "type": "string",
            "minLength": 1
          },
          "playerId": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "Pass",
              "Shot",
              "Tackle",
              "Pressure",
              "PossessionChange",
              "Recovery"
            ]
          },
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ]
          },
          "underPressure": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "receiverOptions": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "decisionSnapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sceneId",
          "matchContext",
          "pitch",
          "preDecision",
          "decision",
          "recordedOutcome",
          "matchId",
          "eventId"
        ],
        "properties": {
          "sceneId": {
            "type": "string",
            "minLength": 1
          },
          "matchContext": {
            "type": "object",
            "required": [
              "minute",
              "score",
              "phase",
              "possessionId",
              "second"
            ],
            "properties": {
              "minute": {
                "type": "integer",
                "minimum": 0
              },
              "score": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "phase": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "possessionId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "second": {
                "type": "integer",
                "minimum": 0,
                "maximum": 59
              }
            },
            "additionalProperties": false
          },
          "pitch": {
            "type": "object",
            "required": [
              "coordinateUnits",
              "lengthMeters",
              "widthMeters",
              "attackDirection"
            ],
            "properties": {
              "coordinateUnits": {
                "type": "string",
                "const": "normalized_0_100"
              },
              "lengthMeters": {
                "type": "integer",
                "minimum": 1
              },
              "widthMeters": {
                "type": "integer",
                "minimum": 1
              },
              "attackDirection": {
                "type": "object",
                "minProperties": 2,
                "additionalProperties": {
                  "enum": [
                    "left_to_right",
                    "right_to_left"
                  ]
                }
              }
            },
            "additionalProperties": false
          },
          "decision": {
            "type": "object",
            "required": [
              "playerId",
              "selectedOptionId",
              "options"
            ],
            "properties": {
              "playerId": {
                "type": "string",
                "minLength": 1
              },
              "selectedOptionId": {
                "type": "string",
                "minLength": 1
              },
              "bodyPartUsed": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "left_foot",
                  "right_foot",
                  "head",
                  "other",
                  null
                ]
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "type"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "pass",
                        "shot",
                        "dribble",
                        "tackle"
                      ]
                    },
                    "receiverId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "recordedOutcome": {
            "type": [
              "string",
              "null"
            ]
          },
          "preDecision": {
            "type": "object",
            "required": [
              "secondsBeforeAction",
              "ball",
              "players"
            ],
            "properties": {
              "secondsBeforeAction": {
                "type": "integer",
                "minimum": 0
              },
              "ball": {
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "additionalProperties": false
              },
              "players": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "teamId",
                    "x",
                    "y"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "teamId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "role": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "matchId": {
            "type": "string",
            "minLength": 1
          },
          "eventId": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "dataStatus": {
      "type": "string"
    },
    "rosterSeason": {
      "type": "string",
      "const": "2026/27"
    },
    "rosterSource": {
      "type": "string"
    },
    "rosterSourceUrl": {
      "type": "string",
      "format": "uri"
    },
    "scenarioLabel": {
      "type": "string"
    },
    "goalLogComplete": {
      "type": "boolean"
    },
    "result": {
      "type": "object",
      "required": [
        "home",
        "away"
      ],
      "additionalProperties": false,
      "properties": {
        "home": {
          "type": "integer",
          "minimum": 0
        },
        "away": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "eventId",
          "teamId",
          "minute",
          "second"
        ],
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string"
          },
          "teamId": {
            "type": "string"
          },
          "minute": {
            "type": "integer",
            "minimum": 0
          },
          "second": {
            "type": "integer",
            "minimum": 0,
            "maximum": 59
          }
        }
      }
    }
  },
  "additionalProperties": false
}
